{
  "name": "@extend-ai/duke-office-charts",
  "version": "0.3.7",
  "description": "Render Office Open XML charts to SVG with WebAssembly",
  "type": "module",
  "license": "MIT AND Apache-2.0 AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/extend-hq/duke-office.git"
  },
  "main": "./browser/index.cjs",
  "module": "./browser/index.js",
  "types": "./browser/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./browser/index.d.ts",
        "default": "./browser/index.js"
      },
      "require": {
        "types": "./browser/index.d.cts",
        "default": "./browser/index.cjs"
      }
    },
    "./office_charts_bg.wasm": "./browser/generated/office_charts_bg.wasm",
    "./package.json": "./package.json",
    "./full": {
      "import": {
        "types": "./browser/index.d.ts",
        "default": "./browser/full.js"
      },
      "require": {
        "types": "./browser/index.d.cts",
        "default": "./browser/full.cjs"
      }
    },
    "./full/office_charts_bg.wasm": "./browser/generated/full/office_charts_bg.wasm"
  },
  "files": [
    "browser/index.*",
    "browser/full.js",
    "browser/full.cjs",
    "browser/loader.js",
    "browser/generated/full/*.wasm",
    "browser/generated/full/*.js",
    "browser/generated/*.wasm",
    "browser/generated/*.js",
    "LICENSE",
    "MAP-DATA-LICENSE",
    "FONT-DATA-LICENSE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "build:browser": "node browser/build.mjs",
    "check:browser": "node browser/check.mjs"
  },
  "sideEffects": false
}
